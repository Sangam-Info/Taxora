rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validName(name) {
      return name is string && name.size() >= 2 && name.size() <= 80;
    }

    function optionalText(value, max) {
      return value is string && value.size() <= max;
    }

    // ------------------------------------------------------------------
    // Account profile: one document per user, only for that user.
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['uid', 'fullName', 'email', 'createdAt', 'lastLoginAt'])
        && request.resource.data.keys().hasOnly(['uid', 'fullName', 'email', 'createdAt', 'lastLoginAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.fullName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'lastLoginAt'])
        && validName(request.resource.data.fullName)
        && request.resource.data.lastLoginAt is timestamp
        && request.resource.data.lastLoginAt <= request.time;

      allow delete: if false;

      // ----------------------------------------------------------------
      // Clients: users/{uid}/clients/{clientId}
      // Only the signed-in owner can read or change their own clients.
      // ----------------------------------------------------------------
      match /clients/{clientId} {

        function validClient(d) {
          return d.keys().hasOnly([
              'ownerId', 'name', 'nameLower', 'itrPeriod', 'address', 'phone', 'email',
              'pan', 'gstin', 'bankName', 'accountHolder', 'accountNumber', 'ifsc',
              'hasPin', 'pinHash', 'pinSalt', 'createdAt', 'updatedAt'])
            && d.keys().hasAll([
              'ownerId', 'name', 'nameLower', 'itrPeriod', 'address', 'phone', 'email',
              'pan', 'gstin', 'bankName', 'accountHolder', 'accountNumber', 'ifsc',
              'hasPin', 'pinHash', 'pinSalt', 'createdAt', 'updatedAt'])
            && d.ownerId == uid
            && d.name is string && d.name.size() >= 2 && d.name.size() <= 120
            && d.nameLower == d.name.lower()
            && d.itrPeriod is string && d.itrPeriod.matches('^[0-9]{4}-[0-9]{2}$')
            && d.address is string && d.address.size() >= 5 && d.address.size() <= 300
            && d.phone is string && d.phone.matches('^[6-9][0-9]{9}$')
            && optionalText(d.email, 254) && (d.email == '' || d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
            && d.pan is string && d.pan.matches('^[A-Z]{5}[0-9]{4}[A-Z]$')
            && d.gstin is string
            && (d.gstin == '' || (d.gstin.matches('^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$')
                                  && d.gstin[2:12] == d.pan))
            && optionalText(d.bankName, 100)
            && optionalText(d.accountHolder, 120)
            && d.accountNumber is string && (d.accountNumber == '' || d.accountNumber.matches('^[0-9]{9,18}$'))
            && d.ifsc is string && (d.ifsc == '' || d.ifsc.matches('^[A-Z]{4}0[A-Z0-9]{6}$'))
            && ((d.accountNumber == '') == (d.ifsc == ''))
            // PIN: only a salted hash is ever stored, never the PIN itself.
            && d.hasPin is bool
            && ((d.hasPin == true
                 && d.pinHash is string && d.pinHash.matches('^[0-9a-f]{64}$')
                 && d.pinSalt is string && d.pinSalt.matches('^[0-9a-f]{32}$'))
              || (d.hasPin == false && d.pinHash == null && d.pinSalt == null))
            && d.updatedAt == request.time;
        }

        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && validClient(request.resource.data)
          && request.resource.data.createdAt == request.time;

        allow update: if isOwner(uid)
          && validClient(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isOwner(uid);
      }
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
