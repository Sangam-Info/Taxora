rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validName(name) {
      return name is string && name.size() >= 2 && name.size() <= 80;
    }

    // One profile document per user, readable and writable only by that user.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['uid', 'fullName', 'email', 'createdAt', 'lastLoginAt'])
        && request.resource.data.keys().hasOnly(['uid', 'fullName', 'email', 'createdAt', 'lastLoginAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.fullName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'lastLoginAt'])
        && validName(request.resource.data.fullName)
        && request.resource.data.lastLoginAt is timestamp
        && request.resource.data.lastLoginAt <= request.time;

      allow delete: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
